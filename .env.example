PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
DB_FILE=./data/rentlogg.db
PUBLIC_BASE_URL=http://localhost:4000
# Optional: enables AI PDF import for room checklists (POST /sites/:id/rooms/import-pdf).
# Without it, that endpoint returns a clean "not configured" error instead of crashing.
ANTHROPIC_API_KEY=
# Required for the daily report email digest (src/services/scheduler.js, 07:00 Europe/Oslo).
# Sent via Gmail SMTP (src/services/mailer.js) — GMAIL_USER is the sending mailbox, and needs
# an app-specific password (not the account password) from
# https://myaccount.google.com/apppasswords, which requires 2-Step Verification enabled first.
# REPORT_FROM_EMAIL's address must match GMAIL_USER (Gmail rejects mismatched From addresses);
# only the display name portion is free, e.g. "Rentlogg <hakon.sundal@gmail.com>".
GMAIL_USER=
GMAIL_APP_PASSWORD=
REPORT_FROM_EMAIL=
