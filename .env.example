PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
DB_FILE=./data/rentlogg.db
PUBLIC_BASE_URL=http://localhost:4000
# Optional: enables AI PDF import for room checklists (POST /sites/:id/rooms/import-pdf).
# Without it, that endpoint returns a clean "not configured" error instead of crashing.
ANTHROPIC_API_KEY=
# Required for the daily report email digest (src/services/scheduler.js, 07:00 Europe/Oslo).
# Get RESEND_API_KEY from https://resend.com — REPORT_FROM_EMAIL must be a verified sender
# (Resend's sandbox address works before a custom domain is verified).
RESEND_API_KEY=
REPORT_FROM_EMAIL=
