PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
DB_FILE=./data/rentlogg.db
PUBLIC_BASE_URL=http://localhost:4000
# Comma-separated list of frontend origins allowed to call this API (e.g.
# "https://rentlogg.no,https://app.rentlogg.no"). Left unset, CORS reflects any origin — fine for
# local dev, but should be set in production once the frontend's real domain(s) are known.
ALLOWED_ORIGINS=
# Where GET /checkin/:qrToken (what a printed site QR code's native-camera link opens) sends the
# scanner on to. Left unset, defaults to https://rentlogg.no.
PUBLIC_FRONTEND_URL=
# Optional: enables AI PDF import for room checklists (POST /sites/:id/rooms/import-pdf).
# Without it, that endpoint returns a clean "not configured" error instead of crashing.
ANTHROPIC_API_KEY=
# Required for the daily report email digest (src/services/scheduler.js, 07:00 Europe/Oslo).
# Sent via Resend (src/services/mailer.js) — the Gmail SMTP setup this used to describe is gone,
# and GMAIL_USER/GMAIL_APP_PASSWORD are no longer read anywhere. There is no fallback: without
# RESEND_API_KEY every send throws.
# REPORT_FROM_EMAIL must be an address on a domain verified in Resend (rentlogg.no); the display
# name portion is free, e.g. "Rentlogg <rapport@rentlogg.no>".
RESEND_API_KEY=
REPORT_FROM_EMAIL=
# Passwords for the accounts `npm run seed` creates. These used to be hardcoded (and published in
# the README) — leave them unset and the seed script generates random ones and prints them once.
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_CLEANER_PASSWORD=
SEED_CUSTOMER_PASSWORD=
# Shared password for the demo accounts `npm run seed:demo` creates. Unset = randomly generated
# and printed at the end of the run.
DEMO_PASSWORD=
# Address `npm run seed:demo` sets as the demo sites' report recipient. Unset = demo@example.com,
# which never delivers anywhere.
DEMO_REPORT_EMAIL=
